#define main server_program_main
#include "SOURCE"
#undef main
#include <assert.h>
#include <sys/wait.h>
static int setup_signals(void){SETUP_SIGNALS}
int main(int argc,char **argv){
 assert(argc==2);int mode=atoi(argv[1]),syncfd[2],pair[2],listener=-1;assert(!pipe(syncfd));
 if(mode==0){listener=socket(AF_INET,SOCK_STREAM,0);assert(listener>=0);struct sockaddr_in a={0};a.sin_family=AF_INET;a.sin_addr.s_addr=htonl(INADDR_LOOPBACK);assert(!bind(listener,(void*)&a,sizeof(a)));assert(!listen(listener,1));}
 else assert(!socketpair(AF_UNIX,SOCK_STREAM,0,pair));
 pid_t pid=fork();assert(pid>=0);
 if(pid==0){close(syncfd[0]);if(mode)close(pair[0]);keep_running=1;assert(!setup_signals());assert(write(syncfd[1],"!",1)==1);close(syncfd[1]);
  int rc;if(mode==0)rc=accept(listener,0,0);else{char b;rc=recv_all(pair[1],&b,1);}
  _exit(rc<0&&!keep_running?0:2);
 }
 close(syncfd[1]);if(mode)close(pair[1]);char c;assert(read(syncfd[0],&c,1)==1);close(syncfd[0]);usleep(20000);kill(pid,SIGTERM);
 int status=0,done=0;for(int i=0;i<100;i++){if(waitpid(pid,&status,WNOHANG)==pid){done=1;break;}usleep(10000);}
 if(!done){kill(pid,SIGKILL);waitpid(pid,&status,0);fprintf(stderr,"FAIL SIGTERM left %s blocked\n",mode?"recv_all":"accept");return 1;}
 assert(WIFEXITED(status)&&WEXITSTATUS(status)==0);if(mode)close(pair[0]);else close(listener);puts("PASS prompt SIGTERM shutdown");return 0;
}
